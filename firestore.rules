rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthenticated() {
      return request.auth != null;
    }

    function isAdmin() {
      return isAuthenticated() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // Users: a student may create/edit only their own profile and can never
    // set or change the role. Admin role is granted manually from the Firebase console.
    match /users/{userId} {
      allow read: if isAuthenticated() && (request.auth.uid == userId || isAdmin());
      allow create: if isAuthenticated() && request.auth.uid == userId
                    && request.resource.data.role == 'student';
      allow update: if isAuthenticated() && request.auth.uid == userId
                    && request.resource.data.role == resource.data.role;
      allow update, delete: if isAdmin();
    }

    // Private per-user data (e.g. the saved GPA calculator): only its owner.
    match /users/{userId}/private/{docId} {
      allow read, write: if isAuthenticated() && request.auth.uid == userId;
    }

    match /news/{newsId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /materials/{materialId} {
      allow read: if true;
      // Anyone may bump the download counter by exactly 1 - nothing else
      allow update: if request.resource.data.diff(resource.data).affectedKeys().hasOnly(['downloadCount'])
                    && request.resource.data.downloadCount == resource.data.downloadCount + 1;
      allow create, update, delete: if isAdmin();
    }

    // Files students send for approval. A student creates and reads only
    // their own; admins review (update) all of them.
    match /material_submissions/{subId} {
      allow create: if isAuthenticated()
                    && request.resource.data.submittedBy == request.auth.uid
                    && request.resource.data.status == 'pending';
      allow read: if isAuthenticated()
                  && (resource.data.submittedBy == request.auth.uid || isAdmin());
      allow update: if isAdmin();
      allow delete: if isAdmin()
                    || (isAuthenticated()
                        && resource.data.submittedBy == request.auth.uid
                        && resource.data.status == 'pending');
    }

    // Address of the Google Drive upload script: signed-in users read it,
    // only admins change it.
    match /config/{docId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    match /quick_links/{linkId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /azkar/{azkarId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Feature switches (study schedule / camps): everyone reads, admin writes.
    match /config/features {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Comments under a news post.
    match /news/{newsId}/comments/{cid} {
      allow read: if true;
      allow create: if isAuthenticated()
                    && request.resource.data.uid == request.auth.uid
                    && request.resource.data.text is string
                    && request.resource.data.text.size() >= 1
                    && request.resource.data.text.size() <= 500
                    && request.resource.data.createdAt == request.time;
      allow delete: if isAdmin()
                    || (isAuthenticated() && resource.data.uid == request.auth.uid);
    }

    // Material reviews: public sees only approved ones, the author sees their
    // own, the admin approves/rejects.
    match /material_reviews/{rid} {
      allow read: if resource.data.status == 'approved'
                  || (isAuthenticated() && resource.data.uid == request.auth.uid)
                  || isAdmin();
      allow create, update: if isAuthenticated()
                    && request.resource.data.uid == request.auth.uid
                    && request.resource.data.status == 'pending'
                    && request.resource.data.rating is int
                    && request.resource.data.rating >= 1
                    && request.resource.data.rating <= 5
                    && request.resource.data.text.size() <= 600
                    && rid == request.resource.data.materialId + '_' + request.auth.uid;
      allow update: if isAdmin();
      allow delete: if isAdmin()
                    || (isAuthenticated() && resource.data.uid == request.auth.uid);
    }

    // Study camps.
    function isMember(campId) {
      return isAuthenticated() &&
        request.auth.uid in get(/databases/$(database)/documents/camps/$(campId)).data.memberIds;
    }
    function canManageCamp(campId) {
      let c = get(/databases/$(database)/documents/camps/$(campId)).data;
      return isAuthenticated() && (c.ownerId == request.auth.uid || request.auth.uid in c.adminIds);
    }

    match /camps/{campId} {
      allow read: if isAuthenticated()
                  && (resource.data.isPublic == true || request.auth.uid in resource.data.memberIds);
      allow create: if isAuthenticated()
                    && request.resource.data.ownerId == request.auth.uid
                    && request.resource.data.name.size() >= 1
                    && request.resource.data.name.size() <= 80;
      // Owner/admins edit freely; any signed-in user may only add or remove themselves.
      allow update: if isAuthenticated()
                    && (resource.data.ownerId == request.auth.uid
                        || request.auth.uid in resource.data.adminIds
                        || request.resource.data.diff(resource.data).affectedKeys().hasOnly(['memberIds']));
      allow delete: if isAuthenticated() && resource.data.ownerId == request.auth.uid;

      match /members/{uid} {
        allow read: if isMember(campId);
        // Joining: yourself only; a private camp needs its invite code.
        allow create: if isAuthenticated() && uid == request.auth.uid
                      && (getAfter(/databases/$(database)/documents/camps/$(campId)).data.ownerId == request.auth.uid
                          || get(/databases/$(database)/documents/camps/$(campId)).data.isPublic == true
                          || request.resource.data.code == get(/databases/$(database)/documents/camps/$(campId)).data.inviteCode);
        allow delete: if isAuthenticated() && (uid == request.auth.uid || canManageCamp(campId));
      }

      match /tasks/{tid} {
        allow read: if isMember(campId);
        allow create, delete: if canManageCamp(campId);
        allow update: if canManageCamp(campId)
                      || (isMember(campId)
                          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['doneBy']));
      }

      match /files/{fid} {
        allow read: if isMember(campId);
        allow write: if canManageCamp(campId);
      }
    }

    // Invite code -> camp lookup (the code is the secret, so reads are by id only).
    match /camp_codes/{code} {
      allow get: if isAuthenticated();
      allow create: if isAuthenticated() && request.resource.data.ownerId == request.auth.uid;
      allow delete: if isAuthenticated() && resource.data.ownerId == request.auth.uid;
    }
  }
}
