rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthenticated() {
      return request.auth != null;
    }

    function isAdmin() {
      return isAuthenticated() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // Users: a student may create/edit only their own profile and can never
    // set or change the role. Admin role is granted manually from the Firebase console.
    match /users/{userId} {
      allow read: if isAuthenticated() && (request.auth.uid == userId || isAdmin());
      allow create: if isAuthenticated() && request.auth.uid == userId
                    && request.resource.data.role == 'student';
      allow update: if isAuthenticated() && request.auth.uid == userId
                    && request.resource.data.role == resource.data.role;
      allow update, delete: if isAdmin();
    }

    // Private per-user data (e.g. the saved GPA calculator): only its owner.
    match /users/{userId}/private/{docId} {
      allow read, write: if isAuthenticated() && request.auth.uid == userId;
    }

    match /news/{newsId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /materials/{materialId} {
      allow read: if true;
      // Anyone may bump the download counter by exactly 1 - nothing else
      allow update: if request.resource.data.diff(resource.data).affectedKeys().hasOnly(['downloadCount'])
                    && request.resource.data.downloadCount == resource.data.downloadCount + 1;
      allow create, update, delete: if isAdmin();
    }

    // Files students send for approval. A student creates and reads only
    // their own; admins review (update) all of them.
    match /material_submissions/{subId} {
      allow create: if isAuthenticated()
                    && request.resource.data.submittedBy == request.auth.uid
                    && request.resource.data.status == 'pending';
      allow read: if isAuthenticated()
                  && (resource.data.submittedBy == request.auth.uid || isAdmin());
      allow update: if isAdmin();
      allow delete: if isAdmin()
                    || (isAuthenticated()
                        && resource.data.submittedBy == request.auth.uid
                        && resource.data.status == 'pending');
    }

    // Address of the Google Drive upload script: signed-in users read it,
    // only admins change it.
    match /config/{docId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    match /quick_links/{linkId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /azkar/{azkarId} {
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}
